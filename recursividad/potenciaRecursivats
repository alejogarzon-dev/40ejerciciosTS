/*
Crea una función recursiva potencia(base, exponente) que calcule base elevado a 
la exponente sin usar Math.pow. Caso base: exponente igual a 0 devuelve 1. Caso 
recursivo: base por potencia(base, exponente - 1). Pruébala con tres valores 
diferentes. 
*/

function potencia(base: number, exponente: number): number {
    if (exponente === 0) {
        return 1;
    }
    return base * potencia(base, exponente - 1);
}       

console.log(potencia(2, 3)); 